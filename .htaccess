# Sistema Escuela — protección de la carpeta del sistema.
# Documentación, respaldos, hojas de cálculo, archivos comprimidos, registros
# y archivos ocultos nunca se sirven por el navegador.
<FilesMatch "(^\.|\.(md|sql|zip|rar|7z|gz|tar|bak|log|txt|xlsx|xls|csv|ini|sh|py|dist)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
# Carpetas de herramientas de edición o control de versiones.
<IfModule mod_alias.c>
  RedirectMatch 404 "/\.(vscode|git|idea)(/|$)"
</IfModule>
